<?xml version="1.0" encoding="utf-8"?>
<!-- 「新」圆点：8dp 品牌橘 + 2dp 深纸色 halo（外圈 12dp），halo 必须比卡片纸色深才看得见。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/new_dot_halo" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/brand" />
        </shape>
    </item>
</layer-list>
