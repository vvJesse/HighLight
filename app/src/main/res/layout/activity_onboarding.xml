<?xml version="1.0" encoding="utf-8"?>
<!-- 首次配置引导（设计稿 05）：三步走完，Cookie / Key / 无障碍。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/onboardingScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/onboardEyebrow"
                style="@style/Eyebrow"
                android:text="WELCOME / 1 / 3" />

            <TextView style="@style/PageTitle" android:text="给亮点，开一扇窗。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stepLabel0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:text="01 粘贴凭据"
                    android:textColor="@color/brand"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stepLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:text="02 连接 AI"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stepLabel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03 开启服务"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card16"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/stepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_serif_sc"
                    android:text="粘贴 B站 Cookie"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stepBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <!-- 第 1 步：B站 Cookie -->
                <LinearLayout
                    android:id="@+id/stepCookie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/onboardCookie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_onboarding_input"
                        android:gravity="top|start"
                        android:hint="粘贴浏览器里的 B站 Cookie，或只粘贴 SESSDATA"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:minLines="4"
                        android:padding="14dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 第 2 步：DeepSeek Key -->
                <LinearLayout
                    android:id="@+id/stepKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/onboardKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_onboarding_input"
                        android:hint="sk-…（只保存在本机）"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 第 3 步：无障碍 -->
                <LinearLayout
                    android:id="@+id/stepA11y"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="4dp"
                        android:text="在系统设置里找到「亮点 · 封面标记」，打开并允许。只有从首页入口打开、且检查通过时才会标记；离开目标 App 会自动停止。"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- V-r2-08：白卡外只放动作与状态，紧接卡片；随步骤切换。 -->
            <LinearLayout
                android:id="@+id/cookieActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/saveCookieStep"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/brand"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="粘贴并保存"
                    android:textAllCaps="false"
                    android:textColor="@color/paper"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/cookieDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_muted" />

                    <TextView
                        android:id="@+id/cookieStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="还没有保存凭据"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keyActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/saveKeyStep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/brand"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:text="保存 Key"
                        android:textAllCaps="false"
                        android:textColor="@color/paper"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/testKeyStep"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/sage"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:text="测试连接"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/keyDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_muted" />

                    <TextView
                        android:id="@+id/keyStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="还没有保存 Key"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/a11yActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/openA11yStep"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/brand"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:text="去系统设置"
                    android:textAllCaps="false"
                    android:textColor="@color/paper"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/a11yDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_muted" />

                    <TextView
                        android:id="@+id/a11yStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="未开启"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="从系统设置返回后，这里会自动复查。"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="4dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/onboardBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/sage"
                android:elevation="0dp"
                android:minWidth="96dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="上一步"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/onboardNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/brand"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="下一步"
                android:textAllCaps="false"
                android:textColor="@color/paper"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/onboardHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="只保存在本机，可在设置中清除"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
