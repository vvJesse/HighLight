<?xml version="1.0" encoding="utf-8"?>
<!-- 设置 v2 · 凭据与 Key（SV2-02）：行式状态 + 白底输入区 + 44dp 按钮，无底部导航。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- B站 Cookie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/SettingsRowTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="B站 Cookie" />

        <TextView
            android:id="@+id/cookieState"
            style="@style/SettingsRowValue"
            android:text="未保存" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <EditText
        android:id="@+id/cookieInput"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/bg_settings_input"
        android:gravity="top|start"
        android:hint="粘贴浏览器里的 B站 Cookie，\n或只粘贴 SESSDATA"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="13sp" />

    <TextView
        style="@style/SettingsHint"
        android:layout_marginTop="12dp"
        android:text="只保存在这台手机，用系统 Keystore 加密" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/saveCookie"
            style="@style/SettingsButton"
            android:text="保存" />

        <TextView
            android:id="@+id/clearCookie"
            style="@style/SettingsButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="清除"
            android:textColor="@color/ink" />
    </LinearLayout>

    <!-- DeepSeek Key -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/SettingsRowTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="DeepSeek Key" />

        <TextView
            android:id="@+id/keyState"
            style="@style/SettingsRowValue"
            android:text="未保存" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <EditText
        android:id="@+id/keyInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_settings_input"
        android:gravity="center_vertical"
        android:hint="sk-••••••1234"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/saveKey"
            style="@style/SettingsButton"
            android:text="保存" />

        <TextView
            android:id="@+id/testKey"
            style="@style/SettingsButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="测试"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/clearKey"
            style="@style/SettingsButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="清除"
            android:textColor="@color/ink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/testDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot_muted"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/testResult"
            style="@style/SettingsRowValue"
            android:layout_marginStart="8dp"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        style="@style/SettingsHint"
        android:layout_marginTop="20dp"
        android:text="凭据与 Key 只保存在这台手机。\nAI 请求由手机直接发往 DeepSeek。" />

    <TextView
        android:id="@+id/debugImport"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="导入测试凭据（bili-cookie.txt）"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
