<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="10dp">

            <TextView style="@style/Eyebrow" android:text="OPEN A LITTLE WINDOW" />

            <TextView
                android:id="@+id/entryTitle"
                style="@style/PageTitle"
                android:text="打开 B站 · 亮点" />

            <TextView
                android:id="@+id/entrySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="8dp"
                android:text="完成检查，再去看自己的推荐。"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- 首页入口的自动检查进度；从设置「检查与引导」进入时不显示。 -->
            <TextView
                android:id="@+id/autoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="2dp"
                android:text="正在检查 1/4…"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/checkList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/entryWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_warn_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/warnTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_serif_sc"
                    android:text="还差 2 项，就能点亮封面。"
                    android:textColor="@color/brand"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/warnBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="返回后自动复查，不会弹出额外窗口。"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- V-r2-11①：入口放进滚动内容区，底部栏只留主按钮 + hint，给警示框留出首屏高度。 -->
            <TextView
                android:id="@+id/entryOnboarding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="重新查看新手引导"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="4dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/entryAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="先完成上面 2 项"
            android:textColor="@color/paper"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/entryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="检查全部通过后，按钮变为「打开 B站」"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
