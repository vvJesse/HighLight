<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐卡（画板 01）：封面右下角深绿时长角标；正文标题 / 作者 · 时间 / 底部「☆ 收藏」。
     封面右上角不再放星标，收藏改到底部文字行（V-03）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/coverBox"
        android:layout_width="match_parent"
        android:layout_height="156dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sage"
            android:contentDescription="内容封面"
            android:scaleType="centerCrop" />

        <!-- 辉光必须在封面之后，否则被不透明封面盖住（V-r2-03）；时长角标再压在最上层保证可读。 -->
        <com.feedreform.highlight.GlowView
            android:id="@+id/glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/videoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_duration"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="@color/paper"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/noto_serif_sc"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"
        android:maxLines="2"
        android:paddingHorizontal="10dp"
        android:paddingTop="9dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/saveBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="收藏到收藏夹"
        android:includeFontPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:text="☆ 收藏"
        android:textColor="@color/brand"
        android:textSize="12sp" />
</LinearLayout>
