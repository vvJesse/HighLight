<?xml version="1.0" encoding="utf-8"?>
<!-- 设置 v2 · 判断偏好（SV2-03）：说明 + 两个自然语言输入 + 生成/规则编辑 + 恢复/清空行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsHint"
        android:layout_marginTop="4dp"
        android:text="B站推荐、关注，以及 B站 / 小红书的原生 App，共用这套偏好。" />

    <TextView
        style="@style/SettingsGroupTitle"
        android:layout_marginTop="20dp"
        android:text="特别关注" />

    <EditText
        android:id="@+id/focusInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_input"
        android:gravity="center_vertical"
        android:hint="编程原理、独立开发、木工实践"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="13sp" />

    <TextView
        style="@style/SettingsGroupTitle"
        android:layout_marginTop="20dp"
        android:text="不想看到" />

    <EditText
        android:id="@+id/avoidInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_input"
        android:gravity="center_vertical"
        android:hint="明星八卦、搞笑段子、情绪化争论"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/prefAutoSave"
        style="@style/SettingsHint"
        android:layout_marginTop="10dp"
        android:text="偏好输入即保存" />

    <TextView
        android:id="@+id/generateRule"
        style="@style/SettingsButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_weight="0"
        android:text="生成判断规则" />

    <TextView
        android:id="@+id/ruleState"
        style="@style/SettingsRowValue"
        android:layout_marginTop="14dp"
        android:text="规则已保存" />

    <TextView
        style="@style/SettingsGroupTitle"
        android:layout_marginTop="22dp"
        android:text="判断规则 · 可编辑" />

    <EditText
        android:id="@+id/ruleInput"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:background="@drawable/bg_settings_input"
        android:gravity="top|start"
        android:hint="规则正文（生成后可手改）"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/restoreRule"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="恢复上次规则"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/clearRule"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:text="清空"
        android:textColor="@color/ink"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />
</LinearLayout>
