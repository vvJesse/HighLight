<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="26dp" android:orientation="vertical">
    <TextView style="@style/Eyebrow" android:text="YOUR LITTLE LIBRARY"/>
    <TextView style="@style/PageTitle" android:text="把喜欢的，留下来。"/>
    <EditText android:id="@+id/search" style="@style/PaperInput" android:layout_marginTop="0dp" android:minHeight="44dp" android:background="@drawable/bg_search_bar" android:hint="⌕  搜索收藏标题" android:inputType="text" android:singleLine="true"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical">
        <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/folderBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView android:id="@+id/newFolder" android:layout_width="wrap_content" android:layout_height="44dp" android:paddingHorizontal="10dp" android:gravity="center" android:text="＋ 新建" android:textColor="@color/brand" android:textSize="13sp"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:id="@+id/sortBar" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal"/>
    </HorizontalScrollView>
    <com.feedreform.highlight.WindowGardenView android:id="@+id/collectionGarden" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:contentDescription="收藏夹摘要"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="10dp" android:text="复制 B站/小红书视频链接，打开亮点即可收藏" android:textColor="@color/muted" android:textSize="12sp"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp" android:gravity="center" android:text="这里还空着。 去首页，留下喜欢的内容吧。" android:lineSpacingExtra="6dp" android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone"/>
</LinearLayout>
