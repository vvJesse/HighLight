<?xml version="1.0" encoding="utf-8"?>
<!-- 小红书首页（设计稿 02a A 版）：主卡片 + 状态行 + 全宽主按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="6dp"
    android:paddingEnd="22dp">

    <FrameLayout
        android:id="@+id/xhsEntryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <com.feedreform.highlight.WindowGardenView
                android:layout_width="200dp"
                android:layout_height="64dp"
                android:contentDescription="窗边小景插画" />

            <TextView
                android:id="@+id/xhsEntryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/noto_serif_sc"
                android:gravity="center"
                android:text="小红书 · 亮点"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/xhsEntryBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="在首页封面上，看见特别关注。"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 「!」叠在卡片右上角，不增加卡片高度；clickable 子 View 消费点击。 -->
        <FrameLayout
            android:id="@+id/entryInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="亮点是什么"
            android:focusable="true">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_info_badge"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="!"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- 状态行：居中、小字、左侧圆点；随检查结果变化。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/xhsEntryDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot_brand" />

        <TextView
            android:id="@+id/xhsEntryState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="待配置 · 还差 2 项"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/xhsEntryStatus"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_xhs"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="打开小红书"
        android:textColor="@color/paper"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="只在你从小红书亮点进入时生效"
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
